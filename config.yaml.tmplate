# 环境配置：DEV, TEST, PROD
environment: DEV

# 开发环境配置
dev:
  # 应用配置
  app:
    name: "General Scaffold Admin System"
    version: "1.0.0"
    debug: true
    host: "0.0.0.0"
    port: 8000
    reload: true
    
  # 数据库配置
  database:
    host: "127.0.0.1"
    port: 12002
    username: "postgres"
    password: "postgres"
    database: "scaffold_dev"
    echo: true  # 打印SQL语句
    pool_size: 10
    max_overflow: 20
    pool_recycle: 3600
    
  # Redis配置
  redis:
    host: "127.0.0.1"
    port: 12001
    password: ""
    db: 0
    max_connections: 50
    decode_responses: true
    
  # JWT配置
  jwt:
    secret_key: "your-secret-key-change-in-production"
    algorithm: "HS256"
    access_token_expire_minutes: 999999
    refresh_token_expire_days: 999999
    
  # 日志配置
  logging:
    level: "DEBUG"
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    file_path: "logs/app.log"
    max_bytes: 10485760  # 10MB
    backup_count: 5
    
  # CORS配置
  cors:
    allow_origins:
      - "http://localhost:3000"
      - "http://localhost:8080"
    allow_credentials: true
    allow_methods:
      - "*"
    allow_headers:
      - "*"
      
  # API日志配置
  api_log:
    enabled: true
    exclude_paths:
      - "/docs"
      - "/redoc"
      - "/openapi.json"
      - "/health"
    log_request_body: true
    log_response_body: true
    max_body_length: 1000  # 最大记录长度

# 测试环境配置
test:
  app:
    name: "General Scaffold Admin System"
    version: "1.0.0"
    debug: true
    host: "0.0.0.0"
    port: 8000
    reload: false
    
  database:
    host: "localhost"
    port: 5432
    username: "postgres"
    password: ""
    database: "scaffold_test"
    echo: false
    pool_size: 5
    max_overflow: 10
    pool_recycle: 3600
    
  redis:
    host: "localhost"
    port: 6379
    password: ""
    db: 1
    max_connections: 30
    decode_responses: true
    
  jwt:
    secret_key: "test-secret-key"
    algorithm: "HS256"
    access_token_expire_minutes: 30
    refresh_token_expire_days: 7
    
  logging:
    level: "INFO"
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    file_path: "logs/app_test.log"
    max_bytes: 10485760
    backup_count: 3
    
  cors:
    allow_origins:
      - "http://test.example.com"
    allow_credentials: true
    allow_methods:
      - "*"
    allow_headers:
      - "*"
      
  api_log:
    enabled: true
    exclude_paths:
      - "/docs"
      - "/redoc"
      - "/openapi.json"
      - "/health"
    log_request_body: true
    log_response_body: true
    max_body_length: 1000

# 生产环境配置
prod:
  app:
    name: "General Scaffold Admin System"
    version: "1.0.0"
    debug: false
    host: "0.0.0.0"
    port: 8000
    reload: false
    
  database:
    host: ""  # 生产环境数据库地址
    port: 5432
    username: ""
    password: ""
    database: "scaffold_prod"
    echo: false
    pool_size: 20
    max_overflow: 40
    pool_recycle: 3600
    
  redis:
    host: ""  # 生产环境Redis地址
    port: 6379
    password: ""
    db: 0
    max_connections: 100
    decode_responses: true
    
  jwt:
    secret_key: ""  # 生产环境必须修改
    algorithm: "HS256"
    access_token_expire_minutes: 120
    refresh_token_expire_days: 30
    
  logging:
    level: "WARNING"
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    file_path: "logs/app_prod.log"
    max_bytes: 52428800  # 50MB
    backup_count: 10
    
  cors:
    allow_origins:
      - "https://your-domain.com"
    allow_credentials: true
    allow_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
    allow_headers:
      - "*"
      
  api_log:
    enabled: true
    exclude_paths:
      - "/docs"
      - "/redoc"
      - "/openapi.json"
      - "/health"
    log_request_body: false
    log_response_body: false
    max_body_length: 500

